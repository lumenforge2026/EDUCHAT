PORT=4000

PGHOST=localhost
PGPORT=5432
PGUSER=edubot
PGPASSWORD=edubot
PGDATABASE=edubot

# RNF-08 — segredo fora do código-fonte
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=30m

# Contas seed (RF-20 — sem sign-up público)
SEED_ADMIN_EMAIL=coordenacao@escola.edu.br
SEED_ADMIN_PASSWORD=EduBot@2026
SEED_EQUIPE_EMAIL=equipe@escola.edu.br
SEED_EQUIPE_PASSWORD=EduBot@2026

CORS_ORIGIN=http://localhost:5173

# RF-04 — webhook do N8N que dispara o workflow de broadcast (WAHA)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/broadcast
# RNF-08 — segredo compartilhado que autoriza o callback de status (RF-06)
N8N_WEBHOOK_SECRET=troque-este-segredo-em-producao

# RF-14 — chave da API do Google Sheets (planilha pública "qualquer pessoa
# com o link pode visualizar"); RNF-08 — nunca versione a chave real
GOOGLE_SHEETS_API_KEY=

# RF-16 — intervalo da sincronização periódica da planilha (0 desativa)
SYNC_INTERVAL_MINUTES=15
