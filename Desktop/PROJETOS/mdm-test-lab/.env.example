# Copie este arquivo para ".env" e preencha os valores antes de rodar "npm start".

# Caminho do executável do adb. Se o "platform-tools" já estiver no PATH do
# Windows, deixe só "adb". Senão, aponte o caminho completo, ex:
# ADB_PATH=C:\Users\ADM_TECTOY\AppData\Local\Android\Sdk\platform-tools\adb.exe
ADB_PATH=adb

# Porta em que o painel local vai rodar (http://localhost:PORT)
PORT=4545

# Package do app do MDM no dispositivo (com.mdmservice, do applicationId do
# app/build.gradle). Usado pra filtrar o logcat só pelo processo do app, em
# vez de despejar todo o log do Android (encoder de vídeo, gralloc etc.).
MDM_PACKAGE=com.mdmservice

# --- Jira (para o botão "Reportar bug") ---
# Base do seu Jira Cloud
JIRA_BASE_URL=https://amazonasinovare.atlassian.net

# E-mail da conta que vai criar os bugs
JIRA_EMAIL=seu-email@amazonasinovare.com.br

# Gere em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Projeto que vai receber os bugs (chave, não o nome)
JIRA_PROJECT_KEY=MDM

# Tipo de issue a criar nesse projeto (o projeto MDM/Portal MDM tem "Bug")
JIRA_ISSUE_TYPE=Bug
